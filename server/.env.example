# ============================================================
# VKM Flowers Server - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=production

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=vkm_flower_shop
DB_SSL=false

# --- Authentication ---
# SECURITY: Generate a strong random secret (e.g. `openssl rand -hex 64`)
JWT_SECRET=your_strong_random_jwt_secret_here

# --- Admin Seed Credentials ---
# SECURITY: Set a strong admin password; the server will hash it with bcrypt
ADMIN_EMAIL=ajith12vkm@gmail.com
ADMIN_PASSWORD=your_strong_admin_password_here

# --- Google OAuth ---
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# --- Frontend URL (for CORS) ---
FRONTEND_URL=https://your-frontend-domain.vercel.app

# --- Firebase Cloud Messaging (optional) ---
# Paste the full JSON of your Firebase service account key (single line)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Render / Hosting (optional) ---
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
# VERCEL=1
